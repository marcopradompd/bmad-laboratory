{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "MPDs — Marco Prado Design System",
  "version": "1.0.0",
  "description": "Sistema de design arquitetônico, sóbrio e de alta precisão para portfólio de UX/AI Designer. Fundações e componentes inspirados em Architect; física de movimento e micro-interações inspiradas em Gemini.",
  "color": {
    "surface": {
      "canvas": "#EAEAE5",
      "subtle": "#F4F4F0",
      "elevated": "#FFFFFF",
      "muted": "#E5E5DF",
      "inverse": "#1C1C1C",
      "inverseElevated": "#262624"
    },
    "ink": {
      "primary": "#1C1C1C",
      "secondary": "#44403C",
      "muted": "#78716C",
      "subtle": "#A8A29E",
      "inverse": "#F5F5F0",
      "inverseMuted": "#A8A29E"
    },
    "border": {
      "default": "#D6D3D1",
      "subtle": "#E7E5E4",
      "strong": "#1C1C1C",
      "inverse": "rgba(255, 255, 255, 0.14)"
    },
    "semantic": {
      "success": {
        "ink": "#166534",
        "bg": "#ECFDF5",
        "border": "#BBF7D0",
        "dot": "#16A34A"
      },
      "warning": {
        "ink": "#854D0E",
        "bg": "#FEFCE8",
        "border": "#FEF08A",
        "dot": "#CA8A04"
      },
      "error": {
        "ink": "#991B1B",
        "bg": "#FEF2F2",
        "border": "#FECACA",
        "dot": "#DC2626"
      },
      "info": {
        "ink": "#1E40AF",
        "bg": "#EFF6FF",
        "border": "#BFDBFE",
        "dot": "#2563EB"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
      "mono": "'Geist Mono', 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace"
    },
    "scale": {
      "display": { "size": "clamp(2.75rem, 6vw, 5.5rem)", "lineHeight": "0.96", "tracking": "-0.045em", "weight": 600 },
      "h2": { "size": "clamp(2rem, 3.6vw, 3rem)", "lineHeight": "1.06", "tracking": "-0.035em", "weight": 500 },
      "h3": { "size": "clamp(1.5rem, 2.4vw, 2.125rem)", "lineHeight": "1.15", "tracking": "-0.025em", "weight": 500 },
      "h4": { "size": "1.25rem", "lineHeight": "1.3", "tracking": "-0.015em", "weight": 500 },
      "bodyLg": { "size": "1.125rem", "lineHeight": "1.65", "tracking": "-0.005em", "weight": 400 },
      "body": { "size": "0.9375rem", "lineHeight": "1.65", "tracking": "0em", "weight": 400 },
      "small": { "size": "0.8125rem", "lineHeight": "1.5", "tracking": "0em", "weight": 400 },
      "monoLabel": { "size": "0.75rem", "lineHeight": "1.2", "tracking": "0.16em", "weight": 500, "transform": "uppercase" }
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px",
    "containerMax": "1400px"
  },
  "radius": {
    "none": "0px",
    "sm": "4px",
    "md": "6px",
    "lg": "10px",
    "pill": "9999px"
  },
  "motion": {
    "easing": {
      "architect": "cubic-bezier(0.16, 1, 0.3, 1)",
      "standard": "cubic-bezier(0.25, 0.1, 0.25, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    },
    "duration": {
      "fast": "180ms",
      "base": "320ms",
      "slow": "700ms",
      "reveal": "850ms",
      "textClip": "1000ms",
      "beam": "2400ms",
      "marquee": "38s"
    }
  }
}
