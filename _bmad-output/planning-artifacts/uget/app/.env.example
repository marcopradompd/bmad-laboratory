# ============================================================================
# uGet — Variáveis de Ambiente (NUNCA commite o arquivo .env real!)
# ============================================================================
NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

# PostgreSQL + PostGIS (Produção / Docker)
DATABASE_URL=postgresql://uget_app:uget_dev_strong_password_change_me@localhost:5432/uget

# Redis (Rate Limit distribuído & Filas Push HA)
REDIS_URL=redis://localhost:6379

# Chave AES-256-GCM (32 bytes em hex = 64 caracteres) — Gerenciar via KMS/Vault em produção
PII_ENCRYPTION_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PII_KEY_VERSION=v1

# Segredos JWT (gerar aleatórios >= 64 chars em produção)
JWT_ACCESS_SECRET=replace_with_64_char_random_access_secret_in_production_uget_2026
JWT_REFRESH_SECRET=replace_with_64_char_random_refresh_secret_in_production_uget_2026
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
